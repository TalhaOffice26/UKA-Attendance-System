<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UKA Attendance Portal | Student Attendance Management</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      --bg-color: #f8fafc;
      --card-border: #e2e8f0;
      --primary-color: #2563eb;
    }

    body {
      font-family: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
      background-color: var(--bg-color);
      color: #1e293b;
    }

    .custom-navbar {
      background: #0f172a;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .brand-logo-container {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: #ffffff;
      padding: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      flex-shrink: 0;
    }
    .brand-logo-img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .hero-banner {
      background: var(--primary-gradient);
      border-radius: 20px;
      padding: 30px 28px;
      color: white;
      box-shadow: 0 15px 30px rgba(30, 60, 114, 0.15);
      position: relative;
      overflow: hidden;
    }

    .stat-pill {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      padding: 10px 18px;
    }

    .category-filter {
      background: #ffffff;
      padding: 6px;
      border-radius: 14px;
      border: 1px solid var(--card-border);
      display: inline-flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .cat-btn {
      border: none;
      padding: 8px 18px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.88rem;
      color: #64748b;
      background: transparent;
      transition: all 0.25s ease;
      text-decoration: none;
    }
    .cat-btn:hover { color: #1e293b; background: #f1f5f9; }
    .cat-btn.active {
      background: var(--primary-color);
      color: white;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

    .batch-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      transition: all 0.25s ease;
      overflow: hidden;
    }
    .batch-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.06);
      border-color: #cbd5e1;
    }
    .card-top-accent { height: 4px; width: 100%; }
    .accent-junior { background: linear-gradient(90deg, #3b82f6, #06b6d4); }
    .accent-ielts { background: linear-gradient(90deg, #f59e0b, #ef4444); }
    .accent-phonetics { background: linear-gradient(90deg, #10b981, #14b8a6); }
    .accent-default { background: linear-gradient(90deg, #6366f1, #8b5cf6); }

    .category-tag {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 6px;
    }
    .tag-junior { background: #e0f2fe; color: #0369a1; }
    .tag-ielts { background: #fef3c7; color: #b45309; }
    .tag-phonetics { background: #dcfce7; color: #15803d; }
    .tag-default { background: #f3e8ff; color: #7e22ce; }

    .btn-enter-batch {
      background: var(--primary-color);
      color: white;
      font-weight: 700;
      border-radius: 12px;
      padding: 10px 14px;
      transition: all 0.2s ease;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn-enter-batch:hover {
      background: #1d4ed8;
      color: white;
      box-shadow: 0 6px 14px rgba(37, 99, 235, 0.25);
    }

    .leaderboard-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
      overflow: hidden;
    }
    .leaderboard-item {
      padding: 14px 18px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .leaderboard-item:last-child { border-bottom: none; }
    .leaderboard-item:hover { background: #f8fafc; }

    .rank-badge {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.95rem;
    }
    .rank-1 { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .rank-2 { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .rank-3 { background: #ffedd5; color: #9a3412; border: 1px solid #fed7aa; }
    .rank-other { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }

    .sidebar-batch-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: #f8fafc;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      text-decoration: none;
      color: #1e293b;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .sidebar-batch-link:hover {
      background: #ffffff;
      border-color: var(--primary-color);
      color: var(--primary-color);
    }

    /* মোবাইল স্ক্রিনের জন্য কম্প্যাক্ট রেসপন্সিভ ডিজাইন */
    @media (max-width: 767.98px) {
      .custom-navbar {
        padding-top: 8px !important;
        padding-bottom: 8px !important;
      }
      .brand-logo-container {
        width: 32px !important;
        height: 32px !important;
        border-radius: 8px !important;
        padding: 2px !important;
      }
      .brand-title {
        font-size: 0.82rem !important;
        line-height: 1.1 !important;
        letter-spacing: 0.2px;
      }
      .brand-subtitle {
        display: none !important;
      }
      .header-actions {
        gap: 5px !important;
      }
      .btn-nav-wa {
        padding: 5px 8px !important;
        font-size: 0.72rem !important;
        border-radius: 20px !important;
      }
      .btn-nav-wa i {
        font-size: 0.85rem !important;
      }
      .btn-nav-menu {
        padding: 5px 9px !important;
        font-size: 0.75rem !important;
        border-radius: 8px !important;
      }
      .btn-nav-menu i {
        font-size: 0.75rem !important;
      }
      .hero-banner {
        padding: 18px 16px !important;
      }
      .hero-banner h2 {
        font-size: 1.25rem !important;
      }
      .stat-pill {
        padding: 8px 12px !important;
      }
      .stat-pill .fs-4 {
        font-size: 1.15rem !important;
      }
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <nav class="custom-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      
      <!-- Brand Logo & Title -->
      <div class="d-flex align-items-center gap-2 gap-md-3">
<div class="brand-logo-container">
  <img src="/logo.png" alt="UKA Logo" class="brand-logo-img" onerror="this.outerHTML='<i class=\'fa-solid fa-graduation-cap text-primary fs-5\'></i>'">
</div>
        <div>
          <div class="fw-bold text-white fs-5 lh-1 brand-title">UKA TECHNICAL INSTITUTE</div>
          <small class="text-white-50 brand-subtitle" style="font-size: 0.72rem; letter-spacing: 0.8px;">STUDENT ATTENDANCE SYSTEM</small>
        </div>
      </div>
      
      <!-- Navbar Buttons -->
      <div class="d-flex align-items-center gap-2 header-actions">
        <!-- WhatsApp Modal Trigger -->
        <button class="btn btn-sm rounded-pill px-3 py-2 fw-bold shadow-sm d-flex align-items-center gap-1 gap-md-2 btn-nav-wa <%= isWhatsAppReady ? 'btn-success' : 'btn-outline-warning' %>" data-bs-toggle="modal" data-bs-target="#whatsappModal" id="waNavBtn">
          <i class="fa-brands fa-whatsapp fs-5"></i>
          <span id="waNavText"><%= isWhatsAppReady ? 'WhatsApp Connected' : 'Connect WhatsApp' %></span>
        </button>

        <!-- Menu Button -->
        <button class="btn btn-warning fw-bold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-1 gap-md-2 btn-nav-menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#dashboardMenuSidebar">
          <i class="fa-solid fa-bars-staggered"></i>
          <span>মেনু</span>
        </button>
      </div>

    </div>
  </nav>

  <div class="container py-3 py-md-4">

    <!-- Hero Banner -->
    <div class="hero-banner mb-4">
      <div class="row align-items-center">
        <div class="col-md-7">
          <span class="badge bg-warning text-dark fw-bold px-3 py-1 mb-2 rounded-pill">
            <i class="fa-solid fa-shield-check me-1"></i> Official Portal
          </span>
          <h2 class="fw-extrabold mb-1">Student Attendance Software</h2>
          <p class="mb-0 text-white-50 fs-6">
            কোর্স ব্যাচ, শিক্ষক ও শিক্ষার্থীদের তথ্য এবং উপস্থিতি স্মার্টলি পরিচালনা করুন।
          </p>
        </div>
        <div class="col-md-5 mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
          <div class="stat-pill text-center">
            <div class="fs-4 fw-bold"><%= allBatches.length %></div>
            <div class="small text-white-50" style="font-size: 0.75rem;">মোট ব্যাচ</div>
          </div>
          <div class="stat-pill text-center">
            <div class="fs-4 fw-bold"><%= totalStudentsCount %></div>
            <div class="small text-white-50" style="font-size: 0.75rem;">মোট শিক্ষার্থী</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Attendance Leaderboard -->
    <div class="leaderboard-card mb-4 p-3 p-md-4">
      <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
          <h5 class="fw-bold mb-0 text-dark fs-6 fs-md-5">
            <i class="fa-solid fa-trophy text-warning me-1 me-md-2"></i> Attendance Leaderboard (Top 5 Regular Students)
          </h5>
          <small class="text-muted" style="font-size: 0.75rem;">চলমান সব ব্যাচে নিয়মিত উপস্থিতির ভিত্তিতে সেরা ৫ জন শিক্ষার্থী</small>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 px-md-3 py-1 fw-bold" style="font-size: 0.75rem;">
          <i class="fa-solid fa-bolt me-1"></i> Live
        </span>
      </div>

      <% if (leaderboard.length === 0) { %>
        <div class="text-center py-4 text-muted small">
          <i class="fa-solid fa-chart-simple text-secondary fa-2x mb-2 d-block"></i>
          ক্লাসের উপস্থিতি নেওয়া শুরু হলে সেরা শিক্ষার্থীদের র‍্যাঙ্কিং এখানে প্রদর্শিত হবে।
        </div>
      <% } else { %>
        <div class="d-flex flex-column">
          <% for(let i = 0; i < leaderboard.length; i++) { 
              let item = leaderboard[i];
              let rankClass = 'rank-other';
              if(i === 0) { rankClass = 'rank-1'; }
              else if(i === 1) { rankClass = 'rank-2'; }
              else if(i === 2) { rankClass = 'rank-3'; }
          %>
            <div class="leaderboard-item">
              <div class="d-flex align-items-center gap-2 gap-md-3 pe-2">
                <div class="rank-badge <%= rankClass %>">
                  #<%= i + 1 %>
                </div>
                <div>
                  <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.9rem;"><%= item.name %></h6>
                  <small class="text-muted d-block" style="font-size: 0.75rem;"><%= item.batchName %> &bull; <span class="text-primary"><%= item.category %></span></small>
                </div>
              </div>
              <div class="text-end flex-shrink-0">
                <div class="badge bg-success rounded-pill px-2 px-md-3 py-1 fw-bold">
                  <%= item.percentage %>&#37;
                </div>
                <small class="d-block text-muted" style="font-size: 0.72rem;">
                  <%= item.presentDays %>/<%= item.totalHeldClasses %> Present
                </small>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Category Filter Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div class="category-filter shadow-sm">
        <a href="/" class="cat-btn <%= selectedCategory === 'All' ? 'active' : '' %>">
          <i class="fa-solid fa-grid-2 me-1"></i> All Batches
        </a>
        <% for(let i = 0; i < categories.length; i++) { %>
          <a href="/?category=<%= encodeURIComponent(categories[i]) %>" class="cat-btn <%= selectedCategory === categories[i] ? 'active' : '' %>">
            <%= categories[i] %>
          </a>
        <% } %>
      </div>
      <div class="text-muted small fw-semibold">
        প্রদর্শিত ব্যাচ: <span class="text-primary fw-bold"><%= batches.length %></span> টি
      </div>
    </div>

    <!-- Batch Grid -->
    <div class="row g-3 g-md-4">
      <% if (batches.length === 0) { %>
        <div class="col-12 py-5 text-center bg-white rounded-4 border">
          <i class="fa-regular fa-folder-open text-muted fa-3x mb-3"></i>
          <h5 class="fw-bold">কোনো ব্যাচ তৈরি করা হয়নি</h5>
          <p class="text-muted small">ডানপাশের মেনু থেকে "+ Create New Batch" এ ক্লিক করে নতুন ব্যাচ তৈরি করুন।</p>
        </div>
      <% } %>

      <% for(let i = 0; i < batches.length; i++) { 
          let b = batches[i];
          let accentClass = 'accent-default';
          let tagClass = 'tag-default';
          if(b.category.includes('Junior')) { accentClass = 'accent-junior'; tagClass = 'tag-junior'; }
          else if(b.category.includes('IELTS')) { accentClass = 'accent-ielts'; tagClass = 'tag-ielts'; }
          else if(b.category.includes('Phonetics')) { accentClass = 'accent-phonetics'; tagClass = 'tag-phonetics'; }
      %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 batch-card shadow-sm border-0">
            <div class="card-top-accent <%= accentClass %>"></div>
            <div class="card-body p-3 p-md-4 d-flex flex-column">
              
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="category-tag <%= tagClass %>"><%= b.category %></span>
                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill small">
                  <i class="fa-solid fa-book-open me-1 text-primary"></i><%= b.totalClasses %> Classes
                </span>
              </div>

              <h5 class="card-title fw-bold text-dark mb-2 lh-base fs-6 fs-md-5"><%= b.name %></h5>
              
              <div class="mb-3 mb-md-4 p-2 bg-light rounded-3 border">
                <small class="text-muted d-block" style="font-size: 0.72rem;">INSTRUCTOR</small>
                <div class="fw-bold text-secondary small">
                  <i class="fa-solid fa-chalkboard-user text-primary me-1"></i> <%= b.teacherName || 'Not Assigned' %>
                  <% if(b.teacherPhone) { %>
                    <span class="ms-1 text-muted fw-normal">(<%= b.teacherPhone %>)</span>
                  <% } %>
                </div>
              </div>

              <div class="mt-auto">
                <a href="/batch/<%= b._id %>" class="btn btn-enter-batch">
                  <span>Enter Batch Attendance</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>

            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- WhatsApp QR & Status Modal -->
  <div class="modal fade" id="whatsappModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="modal-header bg-dark text-white p-4">
          <h5 class="modal-title fw-bold mb-0">
            <i class="fa-brands fa-whatsapp text-success me-2"></i> WhatsApp সংযোগ ব্যবস্থা
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4 text-center">
          
          <div id="waStatusConnected" class="d-none">
            <div class="py-3">
              <i class="fa-solid fa-circle-check text-success fa-4x mb-3"></i>
              <h5 class="fw-bold text-dark">WhatsApp সফলভাবে কানেক্টেড আছে!</h5>
              <p class="text-muted small">হাজিরা সাবমিট করলে স্বয়ংক্রিয়ভাবে শিক্ষার্থীদের অভিভাবকদের নম্বরে মেসেজ চলে যাবে।</p>
              
              <div class="d-flex justify-content-center gap-2 mt-3">
                <form action="/whatsapp/logout" method="POST" onsubmit="return confirm('আপনি কি নিশ্চিতভাবে হোয়াটসঅ্যাপ ডিসকানেক্ট করতে চান?');">
                  <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
                    <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Disconnect
                  </button>
                </form>

                <form action="/whatsapp/reset-cache" method="POST" onsubmit="return confirm('এটি সার্ভারের সকল WhatsApp ক্যাশ ও সেশন মুছে নতুন করে চালু করবে। এগিয়ে যেতে চান?');">
                  <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-2 fw-semibold">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Reset Cache
                  </button>
                </form>
              </div>
            </div>
          </div>

          <div id="waStatusDisconnected" class="d-none">
            <div id="qrLoading">
              <div class="spinner-border text-primary my-4" role="status"></div>
              <p class="text-muted small">QR Code লোড হচ্ছে, অনুগ্রহ করে অপেক্ষা করুন...</p>
            </div>
            
            <div id="qrContainer" class="d-none">
              <img id="waQrImage" src="" alt="WhatsApp QR Code" class="img-fluid border rounded-3 p-2 shadow-sm mb-3" style="max-width: 250px;">
              <div class="text-start bg-light p-3 rounded-3 border small">
                <strong class="d-block text-dark mb-1"><i class="fa-solid fa-mobile-screen-button me-1"></i> কীভাবে স্ক্যান করবেন:</strong>
                1. আপনার ফোনের WhatsApp খুলুন<br>
                2. <strong>Settings</strong> অথবা থ্রি ডট মেনুতে যান<br>
                3. <strong>Linked Devices</strong> এ ট্যাপ করে এই QR কোডটি স্ক্যান করুন
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Sidebar Menu -->
  <div class="offcanvas offcanvas-end border-0 shadow-lg" tabindex="-1" id="dashboardMenuSidebar">
    <div class="offcanvas-header bg-dark text-white p-3">
      <div>
        <h6 class="offcanvas-title fw-bold mb-0">UKA কন্ট্রোল মেনু</h6>
        <small class="text-white-50">ইনস্টিটিউট ড্যাশবোর্ড ও ব্যাচ লিস্ট</small>
      </div>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    
    <div class="offcanvas-body p-3 d-flex flex-column justify-content-between">
      <div>
        <button class="btn btn-primary w-100 fw-bold py-3 rounded-3 shadow-sm mb-4" data-bs-toggle="modal" data-bs-target="#createBatchModal" data-bs-dismiss="offcanvas">
          <i class="fa-solid fa-plus-circle me-1"></i> + Create New Batch
        </button>

        <label class="text-muted small fw-bold text-uppercase px-1 mb-2">সব ব্যাচের তালিকা (<%= allBatches.length %>)</label>
        
        <div class="d-flex flex-column gap-2" style="max-height: 440px; overflow-y: auto;">
          <% if(allBatches.length === 0) { %>
            <div class="text-muted small p-2">কোনো ব্যাচ তৈরি করা নেই।</div>
          <% } %>

          <% for(let i = 0; i < allBatches.length; i++) { 
              let b = allBatches[i];
          %>
            <a href="/batch/<%= b._id %>" class="sidebar-batch-link">
              <div class="text-truncate pe-2">
                <div class="lh-1 text-truncate"><%= b.name %></div>
                <small class="text-muted" style="font-size: 0.72rem;"><%= b.category %></small>
              </div>
              <i class="fa-solid fa-angle-right text-muted"></i>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Logout Button Section -->
      <div class="pt-3 border-top mt-3">
        <a href="/logout" class="btn btn-outline-danger w-100 fw-bold rounded-3 py-2 small">
          <i class="fa-solid fa-right-from-bracket me-2"></i> সিস্টেম থেকে লগআউট
        </a>
        <div class="text-center text-muted small mt-2" style="font-size: 0.72rem;">
          UKA Technical Institute &bull; Attendance System
        </div>
      </div>
    </div>
  </div>

  <!-- Create Batch Modal -->
  <div class="modal fade" id="createBatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <form action="/batch/create" method="POST">
          <div class="modal-header bg-dark text-white p-4">
            <h5 class="modal-title fw-bold mb-0">নতুন ব্যাচ তৈরি করুন</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold small text-secondary">ব্যাচের নাম ও সিডিউল</label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Junior Spoken - Batch 02 (10:15 AM)" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small text-secondary">কোর্স ক্যাটাগরি</label>
              <select name="category" class="form-select" required>
                <% for(let i = 0; i < categories.length; i++) { %>
                  <option value="<%= categories[i] %>"><%= categories[i] %></option>
                <% } %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small text-secondary">মোট ক্লাসের সংখ্যা</label>
              <input type="number" name="totalClasses" class="form-control" value="40" min="1" required>
            </div>
            
            <div class="row g-2">
              <div class="col-md-6 mb-2">
                <label class="form-label fw-bold small text-secondary">শিক্ষকের নাম</label>
                <input type="text" name="teacherName" class="form-control" placeholder="e.g. Tr. Shifa">
              </div>
              <div class="col-md-6 mb-2">
                <label class="form-label fw-bold small text-secondary">শিক্ষকের মোবাইল নম্বর</label>
                <input type="text" name="teacherPhone" class="form-control" placeholder="017xxxxxxxx">
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light p-3">
            <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary fw-bold rounded-3">Create Batch</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- WhatsApp Live Polling Script -->
  <script>
    function checkWhatsAppStatus() {
      fetch('/whatsapp/status')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var navBtn = document.getElementById('waNavBtn');
          var navText = document.getElementById('waNavText');
          var connectedDiv = document.getElementById('waStatusConnected');
          var disconnectedDiv = document.getElementById('waStatusDisconnected');
          var qrLoading = document.getElementById('qrLoading');
          var qrContainer = document.getElementById('qrContainer');
          var waQrImage = document.getElementById('waQrImage');

          var isMobile = window.innerWidth <= 767.98;

          if (data.connected) {
            navBtn.className = "btn btn-sm rounded-pill px-3 py-2 fw-bold shadow-sm d-flex align-items-center gap-1 gap-md-2 btn-nav-wa btn-success";
            navText.innerText = isMobile ? "Connected" : "WhatsApp Connected";
            connectedDiv.classList.remove('d-none');
            disconnectedDiv.classList.add('d-none');
          } else {
            navBtn.className = "btn btn-sm rounded-pill px-3 py-2 fw-bold shadow-sm d-flex align-items-center gap-1 gap-md-2 btn-nav-wa btn-outline-warning";
            navText.innerText = isMobile ? "Connect WA" : "Connect WhatsApp";
            connectedDiv.classList.add('d-none');
            disconnectedDiv.classList.remove('d-none');

            if (data.qrCode) {
              qrLoading.classList.add('d-none');
              qrContainer.classList.remove('d-none');
              waQrImage.src = data.qrCode;
            } else {
              qrLoading.classList.remove('d-none');
              qrContainer.classList.add('d-none');
            }
          }
        })
        .catch(function(err) { console.error("WA Status Error:", err); });
    }

    setInterval(checkWhatsAppStatus, 3000);
    document.addEventListener('DOMContentLoaded', checkWhatsAppStatus);
  </script>
  <%- include('loader') %>
</body>
</html>