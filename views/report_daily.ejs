<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <title>Daily Attendance Report - Class <%= class_number %> (<%= batch.name %>)</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #fff; color: #000; }
    .report-header { border-bottom: 2px solid #000; padding-bottom: 15px; margin-bottom: 20px; }
    @media print {
      .no-print { display: none !important; }
      body { padding: 0; }
      .table-bordered th, .table-bordered td { border: 1px solid #000 !important; }
    }
  </style>
</head>
<body class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <a href="/batch/<%= batch._id %>" class="btn btn-outline-secondary">← Back to Batch</a>
    <button onclick="window.print()" class="btn btn-primary fw-bold px-4">
      <i class="fa-solid fa-print me-1"></i> Print / Save as PDF
    </button>
  </div>

  <div class="report-header text-center">
    <h2 class="fw-bold mb-0">UKA TECHNICAL INSTITUTE</h2>
    <p class="text-muted mb-1">Daily Student Attendance Sheet</p>
    <div class="d-flex justify-content-between mt-3 text-start small fw-bold">
      <div>
        <div>Batch: <span class="fw-normal"><%= batch.name %></span></div>
        <div>Course: <span class="fw-normal"><%= batch.category %></span></div>
      </div>
      <div class="text-end">
        <div>Lecture: <span class="fw-normal">Class <%= class_number %> of <%= batch.totalClasses %></span></div>
        <div>Date: <span class="fw-normal"><%= classDate || 'N/A' %></span></div>
        <div>Instructor: <span class="fw-normal"><%= batch.teacherName || 'N/A' %></span></div>
      </div>
    </div>
  </div>

  <div class="row text-center mb-3 g-2">
    <div class="col-4">
      <div class="border p-2">Total Students: <strong><%= students.length %></strong></div>
    </div>
    <div class="col-4">
      <div class="border p-2 bg-light">Present: <strong class="text-success"><%= presentCount %></strong></div>
    </div>
    <div class="col-4">
      <div class="border p-2 bg-light">Absent: <strong class="text-danger"><%= absentCount %></strong></div>
    </div>
  </div>

  <table class="table table-bordered align-middle">
    <thead class="table-light text-center">
      <tr>
        <th style="width: 50px;">#</th>
        <th class="text-start">Student Name</th>
        <th>Phone Number</th>
        <th style="width: 140px;">Status</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach((s, idx) => { 
          const status = attendanceMap[s._id.toString()] || 'Not Marked';
      %>
        <tr>
          <td class="text-center"><%= idx + 1 %></td>
          <td class="fw-bold"><%= s.name %></td>
          <td class="text-center"><%= s.phone %></td>
          <td class="text-center fw-bold <%= status === 'Present' ? 'text-success' : 'text-danger' %>">
            <%= status %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="d-flex justify-content-between mt-5 pt-4 text-center">
    <div style="width: 200px; border-top: 1px dashed #000; padding-top: 5px;">
      Teacher's Signature
    </div>
    <div style="width: 200px; border-top: 1px dashed #000; padding-top: 5px;">
      Authorized Signature
    </div>
  </div>
<%- include('loader') %>
</body>
</html>