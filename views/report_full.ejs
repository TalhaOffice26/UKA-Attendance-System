<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Full Course Report - <%= batch.name %> | UKA</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }

    .report-sheet {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
      margin-bottom: 40px;
    }

    .institute-header {
      border-bottom: 2px solid #0f172a;
      padding-bottom: 20px;
      margin-bottom: 24px;
    }

    .table thead th {
      background-color: #0f172a;
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 12px 14px;
    }

    .table tbody td {
      padding: 12px 14px;
      vertical-align: middle;
      border-bottom: 1px solid #e2e8f0;
    }

    .signature-box {
      margin-top: 60px;
      padding-top: 10px;
      border-top: 1.5px dashed #64748b;
      text-align: center;
      font-weight: 600;
      font-size: 0.88rem;
      color: #334155;
    }

    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .report-sheet {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
      }
      .table thead th {
        background-color: #f1f5f9 !important;
        color: #000000 !important;
        border: 1px solid #000000 !important;
      }
      .table tbody td {
        border: 1px solid #cbd5e1 !important;
      }
    }
  </style>
</head>
<body class="container py-4">

  <!-- Action Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <a href="/batch/<%= batch._id %>" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold btn-sm shadow-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Batch
    </a>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm">
        <i class="fa-solid fa-print me-2"></i> Print / Save as PDF
      </button>
    </div>
  </div>

  <div class="report-sheet">
    
    <!-- Institute Official Header -->
    <div class="institute-header text-center">
      <div class="d-flex justify-content-center align-items-center gap-2 mb-1">
        <i class="fa-solid fa-graduation-cap fa-2x text-primary"></i>
        <h2 class="fw-bold mb-0 text-dark" style="letter-spacing: 0.5px;">UKA TECHNICAL INSTITUTE</h2>
      </div>
      <p class="text-muted small fw-semibold mb-3 text-uppercase">Full Course Student Attendance & Performance Summary</p>

      <div class="row text-start mt-4 g-2">
        <div class="col-md-6">
          <div class="mb-1"><strong>Batch:</strong> <span class="text-secondary"><%= batch.name %></span></div>
          <div><strong>Category:</strong> <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3"><%= batch.category %></span></div>
        </div>
        <div class="col-md-6 text-md-end">
          <div class="mb-1"><strong>Total Course Classes:</strong> <span class="text-secondary"><%= batch.totalClasses %></span></div>
          <div class="mb-1"><strong>Classes Conducted:</strong> <span class="text-success fw-bold"><%= completedClassesCount %></span></div>
          <div><strong>Instructor:</strong> <span class="text-secondary"><%= batch.teacherName || 'Not Assigned' %></span></div>
        </div>
      </div>
    </div>

    <!-- Summary Stats Header -->
    <div class="row g-3 mb-4 text-center">
      <div class="col-4">
        <div class="p-3 bg-light rounded-3 border">
          <div class="fs-4 fw-bold text-dark"><%= students.length %></div>
          <div class="small text-muted fw-semibold">Total Students</div>
        </div>
      </div>
      <div class="col-4">
        <div class="p-3 bg-light rounded-3 border">
          <div class="fs-4 fw-bold text-success"><%= completedClassesCount %></div>
          <div class="small text-muted fw-semibold">Completed Classes</div>
        </div>
      </div>
      <div class="col-4">
        <div class="p-3 bg-light rounded-3 border">
          <div class="fs-4 fw-bold text-primary"><%= remainingClassesCount %></div>
          <div class="small text-muted fw-semibold">Remaining Classes</div>
        </div>
      </div>
    </div>

    <!-- Students Attendance Table -->
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th style="width: 50px;" class="text-center">#</th>
            <th>Student Name</th>
            <th>Phone Number</th>
            <th class="text-center">Present (Days)</th>
            <th class="text-center">Absent (Days)</th>
            <th style="width: 190px;" class="text-center">Attendance Rate</th>
          </tr>
        </thead>
        <tbody>
          <% if (students.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No students enrolled in this batch.</td>
            </tr>
          <% } %>

          <% for(let i = 0; i < students.length; i++) { %>
            <tr>
              <td class="text-center fw-bold text-muted"><%= i + 1 %></td>
              <td><strong class="text-dark"><%= students[i].name %></strong></td>
              <td class="text-muted"><%= students[i].phone %></td>
              <td class="text-center fw-bold text-success"><%= students[i].present %></td>
              <td class="text-center fw-bold text-danger"><%= students[i].absent %></td>
              <td>
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="badge rounded-pill px-2 py-1 small fw-bold <%= students[i].badgeClass %>">
                    <%= students[i].percentage %>&#37;
                  </span>
                  <small class="text-muted fw-semibold"><%= students[i].present %>/<%= completedClassesCount %></small>
                </div>
                <div class="progress" style="height: 6px;">
                  <div class="progress-bar <%= students[i].badgeClass %> custom-bar" role="progressbar" data-rate="<%= students[i].percentage %>"></div>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Signatures -->
    <div class="row mt-5 pt-3 justify-content-between">
      <div class="col-4">
        <div class="signature-box">
          Course Instructor
        </div>
      </div>
      <div class="col-4">
        <div class="signature-box">
          Academic Coordinator
        </div>
      </div>
      <div class="col-4">
        <div class="signature-box">
          Authorized Principal
        </div>
      </div>
    </div>

  </div>

  <script>
    document.querySelectorAll('.custom-bar').forEach(function(bar) {
      var rate = bar.getAttribute('data-rate') || '0';
      bar.style.width = rate + '%';
    });
  </script>
</body>
</html>